        </mxCell>
        <mxCell id="frontend" parent="clientBoundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;HTML + CSS + JavaScript&lt;br&gt;&lt;br&gt;1. Usuário preenche o formulário&lt;br&gt;2. Validação básica no navegador&lt;br&gt;3. fetch() envia JSON" vertex="1">
          <mxGeometry height="190" width="240" x="30" y="65" as="geometry" />
        </mxCell>
        <mxCell id="apiBoundary" parent="1" style="swimlane;html=1;horizontal=1;startSize=28;rounded=1;fillColor=#FFFBEB;swimlaneFillColor=#FEF3C7;strokeColor=#F59E0B;fontStyle=1;fontColor=#78350F;fontSize=14;" value="SERVIDOR NODE.JS / EXPRESS" vertex="1">
          <mxGeometry height="330" width="790" x="400" y="120" as="geometry" />
        </mxCell>
        <mxCell id="middleware" parent="apiBoundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;CORS + express.json()&lt;br&gt;&lt;br&gt;4. Aceita a origem&lt;br&gt;5. Converte JSON em objeto&lt;br&gt;JSON inválido → 400" vertex="1">
          <mxGeometry height="170" width="165" x="25" y="80" as="geometry" />
        </mxCell>
        <mxCell id="routes" parent="apiBoundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;Rotas&lt;/b&gt;&lt;br&gt;user.routes.js&lt;br&gt;&lt;br&gt;6. Associa método e URL&lt;br&gt;POST /users&lt;br&gt;ao controller" vertex="1">
          <mxGeometry height="170" width="150" x="220" y="80" as="geometry" />
