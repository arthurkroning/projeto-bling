        </mxCell>
        <mxCell id="clientBoundary" parent="1" style="swimlane;html=1;horizontal=1;startSize=28;rounded=1;fillColor=#F8FAFC;swimlaneFillColor=#DBEAFE;strokeColor=#60A5FA;fontStyle=1;fontColor=#1E3A8A;fontSize=14;" value="CLIENTE" vertex="1">
