        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#4B5563;" value="Exemplo: cadastro (POST /users). GET, PUT, PATCH e DELETE percorrem as mesmas camadas." vertex="1">
