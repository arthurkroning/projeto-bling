        <mxCell id="repository" parent="dataBoundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;Repositório&lt;/b&gt;&lt;br&gt;user.repository.js&lt;br&gt;&lt;br&gt;14. Executa SQL&lt;br&gt;parametrizado (?)&lt;br&gt;INSERT / SELECT / UPDATE / DELETE" vertex="1">
