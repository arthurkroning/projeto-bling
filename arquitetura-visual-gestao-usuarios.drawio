        <mxCell id="securityTitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#374151;" value="Controles de segurança demonstrados no fluxo" vertex="1">
          <mxGeometry height="30" width="500" x="40" y="590" as="geometry" />
        </mxCell>
        <mxCell id="securityFrontend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;No frontend&lt;/b&gt;&lt;br&gt;• valida campos antes do envio&lt;br&gt;• escapeHtml() e textContent na renderização&lt;br&gt;• evita injeção de HTML (XSS)" vertex="1">
          <mxGeometry height="135" width="350" x="40" y="635" as="geometry" />
        </mxCell>
        <mxCell id="securityService" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#7C2D12;fontSize=13;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;No serviço&lt;/b&gt;&lt;br&gt;• nome/login: mínimo de 3 caracteres&lt;br&gt;• e-mail válido e único&lt;br&gt;• senha: mínimo de 8 caracteres&lt;br&gt;• BCrypt com custo 10; hash nunca retorna ao cliente" vertex="1">
          <mxGeometry height="135" width="390" x="425" y="635" as="geometry" />
        </mxCell>
        <mxCell id="securityData" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#14532D;fontSize=13;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;Na persistência&lt;/b&gt;&lt;br&gt;• placeholders (?) no SQL reduzem risco de SQL Injection&lt;br&gt;• NOT NULL, UNIQUE e chave primária reforçam a integridade&lt;br&gt;• formato seguro omite o campo password nas respostas" vertex="1">
          <mxGeometry height="135" width="400" x="850" y="635" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=13;align=left;verticalAlign=middle;spacing=10;" value="Observação: CORS está habilitado para qualquer origem no código atual. Em produção, a origem permitida deve ser restrita ao domínio do frontend." vertex="1">
