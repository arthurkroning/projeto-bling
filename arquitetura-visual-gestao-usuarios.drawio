        <mxCell id="database" parent="dataBoundary" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#BBF7D0;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;database.sqlite&lt;br&gt;&lt;br&gt;15. Persiste a tabela users&lt;br&gt;id, nome, e-mail, login,&lt;br&gt;password(hash), active, datas&lt;br&gt;&lt;br&gt;UNIQUE: e-mail e login" vertex="1">
